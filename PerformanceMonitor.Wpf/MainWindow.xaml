<Window x:Class="PerformanceMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:PerformanceMonitor.Wpf.Controls"
        Title="系统监控"
        Width="280" Height="330"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 毛玻璃：DWM BlurBehind 提供模糊；此 Border 以半透明灰色打底（alpha 30%） -->
    <Border x:Name="Root" CornerRadius="16" Background="#4D202020" MouseLeftButtonDown="OnDragWindow">
        <Grid>
            <!-- 四个主表盘：容器 padding 28/12/12/16，间距 10 -->
            <Grid Margin="12,28,12,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <ctrl:GaugeRing x:Name="CpuRing" Grid.Row="0" Grid.Column="0" RingStroke="#FF00D2FF" Title="CPU" RingSize="120" ValueFontSize="19" TitleFontSize="8.5" SubFontSize="7.75"
                                RenderTransformOrigin="0.5,0.5">
                    <ctrl:GaugeRing.RenderTransform>
                        <TranslateTransform X="-6" Y="-6"/>
                    </ctrl:GaugeRing.RenderTransform>
                </ctrl:GaugeRing>

                <ctrl:GaugeRing x:Name="GpuRing" Grid.Row="0" Grid.Column="2" RingStroke="#FFFF6AD5" Title="GPU" RingSize="120" ValueFontSize="19" TitleFontSize="8.5" SubFontSize="7.75"
                                RenderTransformOrigin="0.5,0.5">
                    <ctrl:GaugeRing.RenderTransform>
                        <TranslateTransform X="6" Y="-6"/>
                    </ctrl:GaugeRing.RenderTransform>
                </ctrl:GaugeRing>

                <ctrl:GaugeRing x:Name="MemRing" Grid.Row="1" Grid.Column="0" RingStroke="#FF00E676" Title="MEM" RingSize="120" ValueFontSize="19" TitleFontSize="8.5" SubFontSize="7.75"
                                RenderTransformOrigin="0.5,0.5">
                    <ctrl:GaugeRing.RenderTransform>
                        <TranslateTransform X="-6" Y="6"/>
                    </ctrl:GaugeRing.RenderTransform>
                </ctrl:GaugeRing>

                <ctrl:GaugeRing x:Name="DiskRing" Grid.Row="1" Grid.Column="2" RingStroke="#FFFFD93D" Title="DISK" RingSize="120" ValueFontSize="19" TitleFontSize="8.5" SubFontSize="7.75"
                                RenderTransformOrigin="0.5,0.5">
                    <ctrl:GaugeRing.RenderTransform>
                        <TranslateTransform X="6" Y="6"/>
                    </ctrl:GaugeRing.RenderTransform>
                </ctrl:GaugeRing>
            </Grid>

            <!-- 中央网络表盘：top 52% / 水平居中，压在四表盘之上 -->
            <ctrl:GaugeRing x:Name="NetRing" Panel.ZIndex="5" Title="NET"
                            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,113.6,0,0" RingSize="116"
                            RingStroke="#FFFFFFFF" BgStroke="#0DFFFFFF"
                            ValueFontSize="15.5" TitleFontSize="7.75" SubFontSize="7"/>

            <!-- 左上角按钮组：关闭 ✕ / 自启 ▶ / 置顶 📌 -->
            <StackPanel Orientation="Horizontal" Margin="8,8,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="20">
                <Button x:Name="CloseBtn" Style="{StaticResource CircleButton}" Content="✕" FontSize="11"
                        ToolTip="退出" Click="OnCloseClick"/>
                <Button x:Name="AutoBtn" Style="{StaticResource CircleButton}" Content="▶" FontSize="10"
                        Margin="4,0,0,0" ToolTip="开机自启" Click="OnAutoStartClick"/>
                <Button x:Name="PinBtn" Style="{StaticResource CircleButton}" Content="📌"
                        FontFamily="Segoe UI Emoji, Microsoft YaHei UI" FontSize="10"
                        Margin="4,0,0,0" ToolTip="窗口置顶" Click="OnPinClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
